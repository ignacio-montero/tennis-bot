# tennisbot-watchd — required environment (no secret VALUES here, names only).
# On the homelab this lives as an UNTRACKED .env at
# ~/homelab/services/tennisbot-watchd/.env (next to its docker-compose.yml).

# Everyone Active account credentials (used to log in via MRMLogin.aspx).
EA_EMAIL=
EA_PASSWORD=

# Telegram bot for drop-time notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
