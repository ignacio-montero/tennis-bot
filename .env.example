# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ─── Everyone Active (Paddington) login ──────────────────────────────────────
EA_EMAIL=you@example.com
EA_PASSWORD=your-password-here

# ─── Telegram notifications ──────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your chat id (run scripts/telegram_chat_id.py after messaging the bot once)
TELEGRAM_CHAT_ID=000000000
